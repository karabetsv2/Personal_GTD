# Скопируй этот файл в .env для локального запуска (на Railway переменные задаются в панели проекта).

# Токен бота, полученный от @BotFather
BOT_TOKEN=

# Путь к файлу SQLite. Локально можно оставить как есть.
# На Railway обязательно указывать путь внутри примонтированного Volume, например /data/gtd.db
DATABASE_PATH=gtd.db

# Часовой пояс для дат, дедлайнов и напоминаний (список имён: IANA tz database)
TIMEZONE=Europe/Moscow

# Уровень логирования: DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# ---------- ИИ-функции (OpenRouter) ----------
# Ключ с https://openrouter.ai/keys. Не обязателен для старта бота —
# без него /balance, /coach и разбивка проекта просто ответят,
# что ИИ недоступен, остальной бот продолжит работать как обычно.
OPENROUTER_API_KEY=

# Необязательно — дефолты уже разумные, меняй только если хочешь другую модель/температуру.
# AI_MODEL_DEFAULT=google/gemini-2.5-flash-lite
# AI_MODEL_BREAKDOWN=google/gemini-2.5-flash-lite
# AI_MODEL_BALANCE=google/gemini-2.5-flash-lite
# AI_MODEL_COACH=google/gemini-2.5-flash-lite
# AI_TEMPERATURE_BREAKDOWN=0
# AI_TEMPERATURE_BALANCE=1
# AI_TEMPERATURE_COACH=0.8
# AI_REQUEST_TIMEOUT_SECONDS=30
# COACH_HISTORY_LIMIT=10
